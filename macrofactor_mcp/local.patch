+-- Local addition: verified staples, permanent food memory, Apple Health body readings.
+CREATE TABLE IF NOT EXISTS staples (
+  key        TEXT PRIMARY KEY,   -- normalised name
+  name       TEXT NOT NULL,
+  aliases    TEXT,               -- JSON array of other names
+  brand      TEXT,
+  basis      TEXT NOT NULL,      -- 'per_100g' | 'per_unit' (what `nutrients` describes)
+  nutrients  TEXT,               -- JSON MacroFactor nutrient dict for the basis; NULL = no figures yet
+  unit_label TEXT,               -- e.g. 'egg', 'slice', 'scoop'
+  unit_grams REAL,               -- grams in one unit
+  source     TEXT NOT NULL,      -- 'label' | 'usda' | 'estimate'
+  verified   INTEGER NOT NULL DEFAULT 0,
+  suspect    TEXT,               -- why the figures are doubted
+  notes      TEXT,
+  updated_at INTEGER
+);
+CREATE TABLE IF NOT EXISTS food_history (
+  id         INTEGER PRIMARY KEY AUTOINCREMENT,
+  date       TEXT NOT NULL,      -- local YYYY-MM-DD eaten/landed
+  time       TEXT,               -- HH:MM
+  name       TEXT NOT NULL,
+  brand      TEXT,
+  serving    TEXT,               -- JSON
+  nutrients  TEXT,               -- JSON MacroFactor nutrient dict for the entry
+  source     TEXT NOT NULL,      -- 'claude' (dispatched + confirmed landed) | 'recent_foods' (MF Nightly)
+  key        TEXT NOT NULL,      -- normalised name
+  landed_at  INTEGER,
+  pending_id INTEGER UNIQUE      -- queue id for 'claude' rows
+);
+CREATE INDEX IF NOT EXISTS food_history_date ON food_history(date);
+CREATE UNIQUE INDEX IF NOT EXISTS food_history_recent ON food_history(date, key, source) WHERE source = 'recent_foods';
+CREATE TABLE IF NOT EXISTS body_readings (
+  kind        TEXT NOT NULL,     -- 'weight' (kg) | 'waist' (cm)
+  measured_at TEXT NOT NULL,     -- ISO timestamp from Apple Health
+  date        TEXT NOT NULL,     -- local date of the measurement
+  value       REAL NOT NULL,
+  unit_in     TEXT,              -- unit as sent by the phone
+  received_at INTEGER,
+  PRIMARY KEY (kind, measured_at)
+);
