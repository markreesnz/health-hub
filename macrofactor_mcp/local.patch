diff --git a/src/hub-feed.ts b/src/hub-feed.ts
new file mode 100644
index 0000000..76a268c
--- /dev/null
+++ b/src/hub-feed.ts
@@ -0,0 +1,64 @@
+// Local addition: read-only feed of a day's foods for the Health Hub.
+// GET /hub-foods?date=YYYY-MM-DD   header x-hub-token: <HUB_READ_TOKEN>  (or ?token=)
+// Two sources: foods logged BY HAND in MacroFactor (MF Nightly's recent-foods rows) and foods Claude
+// logged that landed (the dispatch log keeps each payload). A recent-foods row with the same name as
+// one of Claude's that day is dropped, so nothing is counted twice. Read-only: never touches queues.
+import { getUserTz, todayLocal } from "./db/utils";
+
+export interface HubFood { name: string; time: string | null; calories: number | null; protein: number | null; carbs: number | null; fat: number | null; source?: string }
+export interface Dispatch { name: string; served_at_ms: number; landed_at_ms?: number | null; payload?: string | null }
+
+const norm = (s: unknown) => String(s ?? "").toLowerCase().replace(/\s+/g, " ").trim();
+
+function fmt(ms: number, tz: string, opts: Intl.DateTimeFormatOptions) {
+  return new Intl.DateTimeFormat("en-CA", { timeZone: tz, hourCycle: "h23", ...opts }).format(new Date(ms));
+}
+export function localDateOf(ms: number, tz = getUserTz()): string {
+  return fmt(ms, tz, { year: "numeric", month: "2-digit", day: "2-digit" });
+}
+export function localTimeOf(ms: number, tz = getUserTz()): string {
+  return fmt(ms, tz, { hour: "2-digit", minute: "2-digit" });
+}
+
+function claudeFood(d: Dispatch, tz: string): HubFood | null {
+  if (!d.landed_at_ms || !d.payload) return null;
+  let p: any;
+  try { p = JSON.parse(d.payload); } catch { return null; }
+  const n = p?.nutrients ?? {};
+  const num = (v: unknown) => (typeof v === "number" ? v : null);
+  return { name: String(p?.name ?? d.name ?? ""), time: localTimeOf(d.landed_at_ms, tz),
+           calories: num(n.energy), protein: num(n.protein), carbs: num(n.carbs), fat: num(n.fat), source: "claude" };
+}
+
+export function hubFoods(rows: HubFood[], dispatches: Dispatch[], date: string, tz = getUserTz()) {
+  const today = dispatches.filter((d) => localDateOf(d.landed_at_ms || d.served_at_ms, tz) === date);
+  const claudeNames = new Set(today.map((d) => norm(d.name)));
+  const hand = rows.filter((r) => r.name && !claudeNames.has(norm(r.name))).map((r) => ({ ...r, source: "macrofactor" }));
+  const claude = today.map((d) => claudeFood(d, tz)).filter((f): f is HubFood => !!f && !!f.name);
+  // the Hub keys foods by name, so give a repeated name a counter ("Egg", "Egg (2)")
+  const seen = new Map<string, number>();
+  const foods = [...hand, ...claude].map((f) => {
+    const k = norm(f.name), n = (seen.get(k) ?? 0) + 1;
+    seen.set(k, n);
+    return n === 1 ? f : { ...f, name: `${f.name} (${n})` };
+  });
+  return { foods, skipped_duplicates: rows.length - hand.length, from_claude: claude.length };
+}
+
+export async function handleHubFoods(request: Request, env: { DB: D1Database; HUB_READ_TOKEN?: string }): Promise<Response> {
+  const j = (o: unknown, s = 200) => new Response(JSON.stringify(o), { status: s, headers: { "content-type": "application/json" } });
+  if (request.method !== "GET") return j({ error: "GET only" }, 405);
+  const url = new URL(request.url);
+  const tok = request.headers.get("x-hub-token") || url.searchParams.get("token");
+  if (!env.HUB_READ_TOKEN || tok !== env.HUB_READ_TOKEN) return j({ error: "unauthorized" }, 401);
+  const q = url.searchParams.get("date");
+  const date = q && /^\d{4}-\d{2}-\d{2}$/.test(q) ? q : todayLocal();
+  const rows = (await env.DB.prepare(
+    `SELECT name, time, calories, protein, carbs, fat FROM food_log WHERE date = ? AND source = 'shortcut' ORDER BY time`,
+  ).bind(date).all()).results as unknown as HubFood[];
+  const disp = (await env.DB.prepare(
+    `SELECT name, served_at_ms, landed_at_ms, payload FROM food_dispatch_log ORDER BY COALESCE(landed_at_ms, served_at_ms)`,
+  ).all()).results as unknown as Dispatch[];
+  const t = (await env.DB.prepare(`SELECT updated_at FROM today_summary WHERE date = ?`).bind(date).first()) as any;
+  return j({ date, feed_updated_at: t?.updated_at ?? null, ...hubFoods(rows, disp, date) });
+}
