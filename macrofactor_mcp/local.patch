+// ---- local additions: Apple Health read-back and missed-log alerts ----
+
+// POST|GET /body?token=<INGEST_SECRET>&weight=<n>&weight_unit=kg&weight_at=<ISO>&waist=<n>&waist_unit=cm&waist_at=<ISO>
+// (or the same keys in a JSON body). Sent by MF Nightly from Apple Health's latest samples.
+async function handleBody(request: Request, env: Env): Promise<Response> {
+  const url = new URL(request.url);
+  const tok = request.headers.get("x-ingest-secret") || url.searchParams.get("token");
+  if (!env.INGEST_SECRET || tok !== env.INGEST_SECRET) return json({ error: "unauthorized" }, 401);
+  let body: Record<string, unknown> = {};
+  if (request.method === "POST") {
+    try { body = (await request.json()) as Record<string, unknown>; } catch { body = {}; }
+  }
+  const get = (k: string) => (body[k] ?? url.searchParams.get(k) ?? null) as unknown;
+  const num = (v: unknown) => { const n = parseFloat(String(v ?? "").replace(",", ".")); return Number.isFinite(n) ? n : null; };
+  const stored: unknown[] = [];
+  const errors: string[] = [];
+  for (const kind of ["weight", "waist"] as const) {
+    const v = num(get(kind));
+    if (v == null) continue;
+    try {
+      stored.push(await storeBody(env.DB, kind, v, (get(`${kind}_unit`) as string) || (String(get(kind)).replace(/[0-9.,\s]/g, "") || null), (get(`${kind}_at`) as string) || null));
+    } catch (e) {
+      errors.push(`${kind}: ${(e as Error).message}`);
+    }
+  }
+  return json({ ok: errors.length === 0, stored, ...(errors.length ? { errors } : {}) });
+}
+
+async function runMissedAlert(env: Env, minAgeMs = 30 * 60_000, dryRun = false) {
+  const missed = selectMissed(await queueRows(env.DB), Date.now(), minAgeMs);
+  if (!missed.length) return { sent: false, count: 0 };
+  const msg = missedText(missed);
+  if (dryRun) return { sent: false, dry_run: true, ...msg };
+  const push = await notifyPhone(env, "sync", { title: msg.title, text: msg.text });
+  return { sent: push.status === "sent", push: push.status, ...msg };
+}
+
+// GET /missed-check?token=<INGEST_SECRET>[&min_age_min=30][&dry_run=1] — run the missed-log check now.
+async function handleMissedCheck(request: Request, env: Env): Promise<Response> {
+  const url = new URL(request.url);
+  const tok = request.headers.get("x-ingest-secret") || url.searchParams.get("token");
+  if (!env.INGEST_SECRET || tok !== env.INGEST_SECRET) return json({ error: "unauthorized" }, 401);
+  const min = Math.max(0, Number(url.searchParams.get("min_age_min") ?? 30));
+  return json(await runMissedAlert(env, min * 60_000, url.searchParams.get("dry_run") === "1"));
+}
