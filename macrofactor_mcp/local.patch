+  it("log_staple('eggs', 3.5, 'unit') with eggs at 70 kcal each comes to 245 kcal", async () => {
+    const [s] = await findStaple(D1, "eggs");
+    expect(s.name).toBe("Eggs");
+    const c = computeStaple(s, 3.5, "unit");
+    expect(c.nutrients.energy).toBe(245);
+    expect(c.nutrients.protein).toBe(21);
+    expect(c.grams).toBe(175);
+    expect(c.label).toBe("3.5 eggs, 175 g");
+    expect(computeStaple(s, 3.5, "eggs").nutrients.energy).toBe(245); // the staple's own unit word works too
+    expect(computeStaple(s, 100, "g").nutrients.energy).toBe(140);   // 100 g = 2 eggs
+  });
+
+  it("per-100 g staples scale by weight", async () => {
+    const [k] = await findStaple(D1, "kumara");
+    expect(k.name).toBe("Kūmara");
+    expect(computeStaple(k, 150, "g").nutrients.energy).toBe(135);
+    expect(() => computeStaple(k, 2, "unit")).toThrow(/log it in grams/);
+  });
+
+  it("seeds are unverified; Regal is suspect; staples without figures can't be computed", async () => {
+    const [regal] = await findStaple(D1, "regal smoked salmon");
+    expect(regal.suspect).toMatch(/protein/);
+    expect(staplePrompt(regal)).toMatch(/label figures/);
+    const [tb] = await findStaple(D1, "thoroughbread");
+    expect(tb.nutrients).toBeNull();
+    expect(() => computeStaple(tb, 2, "slice")).toThrow(/no nutrition figures/);
+  });
+});
+
+describe("REQUIRED: fuzzy search", () => {
+  it("'thoroughbred' finds the Thoroughbread staple", async () => {
+    const hits = await findStaple(D1, "thoroughbred");
+    expect(hits[0].name).toBe("Thoroughbread olive & rosemary");
+    expect(hits[0].score).toBeGreaterThan(0.85);
+  });
+  it("handles case, accents, plurals and typos, and scores unrelated foods low", () => {
+    expect(fuzzyScore("KUMARA", "Kūmara")).toBe(1);
+    expect(fuzzyScore("eggs", "Egg")).toBe(1);
+    expect(fuzzyScore("avacado", "Hass avocado")).toBeGreaterThan(0.8);
+    expect(fuzzyScore("chiken thigh", "Chicken thigh")).toBeGreaterThan(0.9);
+    expect(fuzzyScore("egg", "fig")).toBeLessThan(0.5);
+  });
+  it("saved foods are fuzzy-matched too", async () => {
+    raw.exec(`INSERT INTO food_library (name, brand, source, calories) VALUES ('Rose''s Chilli Crisp', NULL, 'recent', 33.9)`);
+    expect((await searchSaved(D1, "roses chili crisp"))[0].name).toBe("Rose's Chilli Crisp");
+  });
+});
+
+describe("REQUIRED: permanent food memory", () => {
+  it("a landed food can still be found 3 days later, and later syncs don't remove it", async () => {
+    const landed = Date.now() - 3 * DAY;
+    raw.prepare(`INSERT INTO food_dispatch_log (pending_id, name, calories, served_at_ms, landed_at_ms, payload) VALUES (41, 'Chicken breast, cooked (200 g)', 330, ?, ?, ?)`)
+      .run(landed - 60_000, landed, egg());
+    await recordLanded(D1, [41]);
