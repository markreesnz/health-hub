+import { describe, it, expect } from "vitest";
+import { hubFoods, localDateOf, localTimeOf } from "../src/hub-feed";
+
+const TZ = "Pacific/Auckland";
+const row = (name: string, time = "08:00") => ({ name, time, calories: 100, protein: 1, carbs: 1, fat: 1 });
+// 2026-11-19 12:29 NZDT = 2026-11-18T23:29Z
+const lunch = Date.parse("2026-11-18T23:29:00Z");
+const payload = (name: string, energy: number) => JSON.stringify({ name, nutrients: { energy, protein: 62, carbs: 0, fat: 7.1 } });
+
+describe("hub feed", () => {
+  it("uses the user's local date and time", () => {
+    expect(localDateOf(lunch, TZ)).toBe("2026-11-19");
+    expect(localTimeOf(lunch, TZ)).toBe("12:29");
+  });
+  it("includes Claude's landed foods with their macros, and drops the same food from the recent-foods rows", () => {
+    const r = hubFoods([row("Salmon (Akaroa)"), row("Chicken Breast, Cooked (200 G)")],
+      [{ name: "Chicken breast, cooked (200 g)", served_at_ms: lunch - 60000, landed_at_ms: lunch, payload: payload("Chicken breast, cooked (200 g)", 330) }],
+      "2026-11-19", TZ);
+    expect(r.foods.map((f) => [f.name, f.source, f.time, f.calories])).toEqual([
+      ["Salmon (Akaroa)", "macrofactor", "08:00", 100],
+      ["Chicken breast, cooked (200 g)", "claude", "12:29", 330],
+    ]);
+  });
+  it("skips Claude foods that never landed or have no stored payload", () => {
+    const r = hubFoods([], [
+      { name: "Queued", served_at_ms: lunch, landed_at_ms: null, payload: payload("Queued", 1) },
+      { name: "Old", served_at_ms: lunch, landed_at_ms: lunch, payload: null },
+    ], "2026-11-19", TZ);
+    expect(r.foods).toEqual([]);
+  });
+  it("numbers repeated names so each is its own item", () => {
+    const d = (ms: number) => ({ name: "Egg", served_at_ms: ms, landed_at_ms: ms, payload: payload("Egg", 72) });
+    const r = hubFoods([], [d(lunch), d(lunch + 3600000)], "2026-11-19", TZ);
+    expect(r.foods.map((f) => f.name)).toEqual(["Egg", "Egg (2)"]);
+  });
+  it("a Claude food from another day doesn't hide today's hand-logged one", () => {
+    const r = hubFoods([row("Egg")], [{ name: "Egg", served_at_ms: lunch - 86400000, landed_at_ms: lunch - 86400000, payload: payload("Egg", 72) }], "2026-11-19", TZ);
+    expect(r.foods.map((f) => f.name)).toEqual(["Egg"]);
+  });
+});
