diff --git a/tests/d1-sqlite.ts b/tests/d1-sqlite.ts
new file mode 100644
index 0000000..0aaa51f
--- /dev/null
+++ b/tests/d1-sqlite.ts
@@ -0,0 +1,29 @@
+// Minimal D1Database stand-in over Node's built-in SQLite, so tests run real SQL against schema.sql.
+import { DatabaseSync } from "node:sqlite";
+import { readFileSync } from "node:fs";
+
+export function makeD1(files: string[] = ["schema.sql"]) {
+  const db = new DatabaseSync(":memory:");
+  for (const f of files) db.exec(readFileSync(f, "utf8"));
+  const plain = (r: any) => (r ? { ...r } : null);
+  class Stmt {
+    constructor(public sql: string, public params: unknown[] = []) {}
+    bind(...p: unknown[]) { return new Stmt(this.sql, p.map((v) => (v === undefined ? null : v))); }
+    async all() { return { results: db.prepare(this.sql).all(...(this.params as any[])).map(plain), success: true, meta: {} }; }
+    async first(col?: string) { const r = plain(db.prepare(this.sql).get(...(this.params as any[]))); return r && col ? r[col] : r; }
+    async run() {
+      const r = db.prepare(this.sql).run(...(this.params as any[]));
+      return { results: [], success: true, meta: { changes: Number(r.changes), last_row_id: Number(r.lastInsertRowid) } };
+    }
+  }
+  const D1 = {
+    prepare: (sql: string) => new Stmt(sql),
+    // like D1: a SELECT in a batch returns its rows, anything else its run() result
+    batch: async (stmts: Stmt[]) => {
+      const out = [];
+      for (const s of stmts) out.push(/^\s*(select|with)\b/i.test(s.sql) ? await s.all() : await s.run());
+      return out;
+    },
+  };
+  return { D1: D1 as unknown as D1Database, raw: db };
+}
