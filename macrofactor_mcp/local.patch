+// ---- staples ----
+export async function allStaples(DB: D1Database): Promise<Staple[]> {
+  return ((await DB.prepare(`SELECT * FROM staples ORDER BY name`).all()).results as any[]).map(stapleFromRow);
+}
+
+export async function findStaple(DB: D1Database, name: string) {
+  const ranked = rank(name, await allStaples(DB), (s) => [s.name, ...s.aliases, s.brand ? `${s.brand} ${s.name}` : null]);
+  return ranked;
+}
+
+export async function upsertStaple(DB: D1Database, s: Omit<Staple, "updated_at">) {
+  const key = normalize(s.name);
+  const existing = (await DB.prepare(`SELECT * FROM staples WHERE key = ?`).bind(key).first()) as any;
+  const aliases = [...new Set([...(existing ? stapleFromRow(existing).aliases : []), ...s.aliases].map((a) => a.trim()).filter(Boolean))];
+  await DB.prepare(
+    `INSERT INTO staples (key, name, aliases, brand, basis, nutrients, unit_label, unit_grams, source, verified, suspect, notes, updated_at)
+     VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
+     ON CONFLICT(key) DO UPDATE SET name=excluded.name, aliases=excluded.aliases, brand=excluded.brand, basis=excluded.basis,
+       nutrients=excluded.nutrients, unit_label=excluded.unit_label, unit_grams=excluded.unit_grams, source=excluded.source,
+       verified=excluded.verified, suspect=excluded.suspect, notes=excluded.notes, updated_at=excluded.updated_at`,
+  ).bind(key, s.name, JSON.stringify(aliases), s.brand, s.basis, s.nutrients ? JSON.stringify(s.nutrients) : null,
+    s.unit_label, s.unit_grams, s.source, s.verified ? 1 : 0, s.suspect, s.notes, nowMs()).run();
+  return { created: !existing, staple: stapleFromRow((await DB.prepare(`SELECT * FROM staples WHERE key = ?`).bind(key).first()) as any) };
+}
+
+// ---- permanent food memory ----
+/** Copy foods the phone just confirmed (by queue id) into food_history. */
+export async function recordLanded(DB: D1Database, pendingIds: number[]) {
+  if (!pendingIds.length) return;
+  const rows = (await DB.prepare(
+    `SELECT pending_id, name, landed_at_ms, payload FROM food_dispatch_log WHERE payload IS NOT NULL AND landed_at_ms IS NOT NULL
+     AND pending_id IN (${pendingIds.map(() => "?").join(",")})`,
+  ).bind(...pendingIds).all()).results as any[];
+  if (!rows.length) return;
+  const stmt = DB.prepare(
+    `INSERT OR IGNORE INTO food_history (date, time, name, brand, serving, nutrients, source, key, landed_at, pending_id)
+     VALUES (?, ?, ?, ?, ?, ?, 'claude', ?, ?, ?)`,
+  );
+  await DB.batch(rows.map((r) => {
+    const p = safeParse(r.payload) as any;
+    const name = p?.name ?? r.name;
+    return stmt.bind(localDate(r.landed_at_ms), localHHMM(r.landed_at_ms), name, p?.brand ?? null,
+      JSON.stringify(p?.serving ?? "one"), JSON.stringify(p?.nutrients ?? {}), normalize(name), r.landed_at_ms, r.pending_id);
+  }));
+}
+
+/** Mirror a day's recent-foods rows (MF Nightly) into food_history; other days are never touched. */
+export async function recordRecentDay(DB: D1Database, date: string) {
+  const rows = (await DB.prepare(
+    `SELECT time, name, serving_size, serving_qty, serving_weight_g, calories, protein, carbs, fat FROM food_log WHERE date = ? AND source = 'shortcut'`,
+  ).bind(date).all()).results as any[];
+  const stmts: D1PreparedStatement[] = [DB.prepare(`DELETE FROM food_history WHERE date = ? AND source = 'recent_foods'`).bind(date)];
+  const ins = DB.prepare(
+    `INSERT OR REPLACE INTO food_history (date, time, name, brand, serving, nutrients, source, key, landed_at, pending_id)
+     VALUES (?, ?, ?, NULL, ?, ?, 'recent_foods', ?, ?, NULL)`,
+  );
+  for (const r of rows) {
+    const n: Nutr = {};
+    for (const [k, col] of [["energy", "calories"], ["protein", "protein"], ["carbs", "carbs"], ["fat", "fat"]] as const) if (r[col] != null) n[k] = r[col];
+    stmts.push(ins.bind(date, r.time, r.name, JSON.stringify(r.serving_size ? `${r.serving_qty ?? 1} ${r.serving_size}` : "1 portion (as last logged)"),
+      JSON.stringify(n), normalize(r.name), nowMs()));
+  }
+  await DB.batch(stmts);
+}
+
+export async function searchHistory(DB: D1Database, query: string, limit = 8) {
+  const rows = (await DB.prepare(
+    `SELECT date, time, name, brand, serving, nutrients, source, key FROM food_history ORDER BY date DESC, time DESC LIMIT 5000`,
+  ).all()).results as any[];
+  const byKey = new Map<string, any>();
+  for (const r of rows) {
+    const k = `${normalize(r.name)}|${r.source}`;
+    const cur = byKey.get(k);
+    if (cur) cur.times_seen++;
+    else byKey.set(k, { ...r, times_seen: 1 });
+  }
+  return rank(query, [...byKey.values()], (r) => [r.name, r.brand ? `${r.brand} ${r.name}` : null]).slice(0, limit).map((r) => ({
+    name: r.name, brand: r.brand ?? undefined, last_eaten: `${r.date}${r.time ? ` ${r.time}` : ""}`, times_seen: r.times_seen,
+    source: r.source === "claude" ? "logged via Claude (confirmed landed)" : "MacroFactor recent foods (portion as last logged)",
+    serving: safeParse(r.serving), per_entry: safeParse(r.nutrients), score: r.score,
+  }));
+}
+
+export async function searchSaved(DB: D1Database, query: string, limit = 25) {
+  const rows = (await DB.prepare(
+    `SELECT name, brand, source, serving_size, serving_qty, serving_weight_g, calories, protein, fat, carbs FROM food_library`,
+  ).all()).results as any[];
+  return rank(query, rows, (r) => [r.name, r.brand ? `${r.brand} ${r.name}` : null]).slice(0, limit);
+}
+
+// ---- read-back: entries for get_food_log ----
+export async function readbackFoodLog(DB: D1Database, base: any[], start?: string, end?: string) {
+  const days = [...new Set(base.map((r) => r.date))];
+  const exportDays = new Set(
+    ((await DB.prepare(`SELECT DISTINCT date FROM food_log WHERE source IS NULL`).all()).results as any[]).map((r) => r.date),
+  );
+  const from = start ?? localDate(nowMs() - 6 * 86400000);
+  const to = end ?? localDate(nowMs());
+  const claude = ((await DB.prepare(
+    `SELECT date, time, name, brand, serving, nutrients FROM food_history WHERE source = 'claude' AND date BETWEEN ? AND ? ORDER BY date, time`,
+  ).bind(from, to).all()).results as any[]);
+  const out: any[] = [];
+  const claudeKeys = new Set(claude.map((c) => `${c.date}|${normalize(c.name)}`));
+  for (const r of base) {
+    if (exportDays.has(r.date)) { out.push({ ...r, entry_source: "export" }); continue; }
+    if (claudeKeys.has(`${r.date}|${normalize(r.name)}`)) continue;
+    out.push({ ...r, entry_source: "recent_foods (one row per food per day, portion as last logged)" });
+  }
+  for (const c of claude) {
+    if (exportDays.has(c.date)) continue;
+    const n = safeParse(c.nutrients) as Nutr;
+    out.push({ date: c.date, time: c.time, name: c.name, calories: n.energy ?? null, protein: n.protein ?? null, carbs: n.carbs ?? null,
+      fat: n.fat ?? null, serving_size: typeof safeParse(c.serving) === "string" ? safeParse(c.serving) : "one", entry_source: "connector (dispatched and confirmed landed)" });
+  }
+  out.sort((a, b) => `${a.date} ${a.time ?? ""}`.localeCompare(`${b.date} ${b.time ?? ""}`));
+  void days;
+  return out;
+}
+
+// ---- read-back: body weight / waist from Apple Health (via MF Nightly) ----
+export function toSI(kind: "weight" | "waist", value: number, unit?: string | null): number {
+  const u = normalize(unit ?? "");
+  if (kind === "weight") return u.startsWith("lb") || u.startsWith("pound") ? value * 0.45359237 : u === "g" ? value / 1000 : value;
+  return u === "in" || u.startsWith("inch") ? value * 2.54 : u === "mm" ? value / 10 : u === "m" ? value * 100 : value;
+}
+
+export async function storeBody(DB: D1Database, kind: "weight" | "waist", value: number, unit: string | null, measuredAt: string | null) {
+  if (!(value > 0)) return null;
+  const si = Math.round(toSI(kind, value, unit) * 100) / 100;
+  if (kind === "weight" && (si < 25 || si > 350)) throw new Error(`implausible weight ${si} kg`);
+  if (kind === "waist" && (si < 40 || si > 250)) throw new Error(`implausible waist ${si} cm`);
+  // a "+13:00" offset typed into a URL arrives as " 13:00" — put the plus back
+  const iso = measuredAt ? measuredAt.trim().replace(/ (\d{2}:?\d{2})$/, "+$1") : null;
+  const at = iso && !Number.isNaN(Date.parse(iso)) ? new Date(Date.parse(iso)) : new Date();
+  const date = localDate(at.getTime());
+  await DB.prepare(
+    `INSERT OR REPLACE INTO body_readings (kind, measured_at, date, value, unit_in, received_at) VALUES (?, ?, ?, ?, ?, ?)`,
+  ).bind(kind, at.toISOString(), date, si, unit ?? null, nowMs()).run();
+  if (kind === "weight") {
+    // fill the day's scale weight unless an export owns that row
+    await DB.prepare(
+      `INSERT INTO days (date, scale_weight, source) VALUES (?, ?, 'health')
+       ON CONFLICT(date) DO UPDATE SET scale_weight = excluded.scale_weight WHERE days.source IS NOT NULL`,
+    ).bind(date, si).run();
+  }
+  return { kind, date, value: si, unit: kind === "weight" ? "kg" : "cm" };
+}
+
+export async function bodyReadings(DB: D1Database, kind: "weight" | "waist", from: string, to: string) {
+  return (await DB.prepare(
+    `SELECT date, measured_at, value FROM body_readings WHERE kind = ? AND date BETWEEN ? AND ? ORDER BY measured_at`,
+  ).bind(kind, from, to).all()).results as any[];
+}
+
+// ---- missed logs ----
+export async function queueRows(DB: D1Database): Promise<QueueRow[]> {
+  const [food, batch] = await Promise.all([
+    DB.prepare(`SELECT id, created, claimed_at, payload FROM pending_food`).all(),
+    DB.prepare(`SELECT id, created, claimed_at, items FROM pending_batch`).all(),
+  ]);
+  return [
+    ...(food.results as any[]).map((r) => ({ id: r.id, created: r.created, claimed_at: r.claimed_at, names: [(safeParse(r.payload) as any)?.name ?? "food"] })),
+    ...(batch.results as any[]).map((r) => ({ id: -r.id, created: r.created, claimed_at: r.claimed_at,
+      names: ((safeParse(r.items) as any) || []).map((i: any) => i?.name ?? "food") })),
+  ];
+}
+
+// ---- day feedback ----
+export async function firstFoodToday(DB: D1Database): Promise<string | null> {
+  const today = todayLocal();
+  const a = (await DB.prepare(`SELECT MIN(time) t FROM food_log WHERE date = ? AND time IS NOT NULL`).bind(today).first()) as any;
+  const b = (await DB.prepare(`SELECT MIN(time) t FROM food_history WHERE date = ? AND time IS NOT NULL`).bind(today).first()) as any;
+  const ts = [a?.t, b?.t].filter(Boolean).sort();
+  return ts[0] ?? null;
+}
+
+export async function landedSince(DB: D1Database, sinceMs: number): Promise<M[]> {
+  const today = todayLocal();
+  const rows = (await DB.prepare(
+    `SELECT landed_at_ms, payload FROM food_dispatch_log WHERE landed_at_ms > ? AND payload IS NOT NULL`,
+  ).bind(sinceMs).all()).results as any[];
+  return rows.filter((r) => localDate(r.landed_at_ms) === today).map((r) => toM((safeParse(r.payload) as any)?.nutrients));
+}
+
+export async function queuedMacros(DB: D1Database): Promise<M[]> {
+  const rows = (await DB.prepare(`SELECT payload FROM pending_food`).all()).results as any[];
+  const batches = (await DB.prepare(`SELECT items FROM pending_batch`).all()).results as any[];
+  return [
+    ...rows.map((r) => toM((safeParse(r.payload) as any)?.nutrients)),
+    ...batches.flatMap((b) => ((safeParse(b.items) as any) || []).map((i: any) => toM(i?.nutrients))),
+  ];
+}
+
+// ---- ZOE status pushed by Health Hub ----
+export async function storeZoe(DB: D1Database, date: string, zoe: unknown) {
+  await DB.prepare(`INSERT OR REPLACE INTO zoe_status (date, payload, updated_at) VALUES (?, ?, ?)`)
+    .bind(date, JSON.stringify(zoe), nowMs()).run();
+}
+
+export async function zoeToday(DB: D1Database) {
+  try {
+    const r = (await DB.prepare(`SELECT payload, updated_at FROM zoe_status WHERE date = ?`).bind(todayLocal()).first()) as any;
+    return r ? { zoe: safeParse(r.payload), received: Number(r.updated_at) } : null;
+  } catch {
+    return null; // table not migrated yet
+  }
+}
