diff --git a/src/extras.ts b/src/extras.ts
new file mode 100644
index 0000000..3df4ba0
--- /dev/null
+++ b/src/extras.ts
@@ -0,0 +1,506 @@
+// Local additions (Mark's deployment): verified staples, permanent food memory + fuzzy search,
+// read-back of body weight / waist, missed-log alerts and running day feedback.
+// Pure logic is exported separately from the D1 helpers so it can be unit-tested.
+import { NUTRIENT_KEYS } from "./mf-schema";
+import { getUserTz, todayLocal, safeParse } from "./db/utils";
+
+type Nutr = Record<string, number>;
+
+// ============================ fuzzy matching ============================
+
+export function normalize(s: unknown): string {
+  return String(s ?? "")
+    .normalize("NFD").replace(/[̀-ͯ]/g, "")   // kūmara → kumara
+    .toLowerCase().replace(/&/g, " and ").replace(/[^a-z0-9]+/g, " ").trim().replace(/\s+/g, " ");
+}
+
+function singular(t: string): string {
+  if (t.length > 4 && t.endsWith("ies")) return t.slice(0, -3) + "y";
+  if (t.length > 4 && /(ches|shes|sses|xes|zes|oes)$/.test(t)) return t.slice(0, -2);
+  if (t.length > 3 && t.endsWith("s") && !t.endsWith("ss")) return t.slice(0, -1);
+  return t;
+}
+
+export function tokens(s: unknown): string[] {
+  return normalize(s).split(" ").filter(Boolean).map(singular);
+}
+
+// Optimal string alignment distance (Levenshtein + adjacent transpositions).
+function osa(a: string, b: string): number {
+  const m = a.length, n = b.length;
+  if (!m) return n;
+  if (!n) return m;
+  const d: number[][] = Array.from({ length: m + 1 }, (_, i) => [i, ...Array(n).fill(0)]);
+  for (let j = 0; j <= n; j++) d[0][j] = j;
+  for (let i = 1; i <= m; i++) {
+    for (let j = 1; j <= n; j++) {
+      const cost = a[i - 1] === b[j - 1] ? 0 : 1;
+      d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + cost);
+      if (i > 1 && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1]) d[i][j] = Math.min(d[i][j], d[i - 2][j - 2] + 1);
+    }
+  }
+  return d[m][n];
+}
+
+const sim = (a: string, b: string) => (a === b ? 1 : 1 - osa(a, b) / Math.max(a.length, b.length, 1));
+
+/** 0–1 similarity of a search query to a food name (case, accents, typos, plurals, word order). */
+export function fuzzyScore(query: unknown, candidate: unknown): number {
+  const q = tokens(query), c = tokens(candidate);
+  if (!q.length || !c.length) return 0;
+  const qj = q.join(" "), cj = c.join(" ");
+  if (qj === cj) return 1;
+  // every query word against its best candidate word (prefixes count: "thorough" → "thoroughbread")
+  const per = q.map((qt) =>
+    Math.max(...c.map((ct) => (ct.startsWith(qt) && qt.length >= 3 ? 0.9 + 0.1 * (qt.length / ct.length) : sim(qt, ct)))),
+  );
+  const words = per.reduce((a, b) => a + b, 0) / per.length;
+  const whole = sim(qj.replace(/ /g, ""), cj.replace(/ /g, ""));
+  const contained = cj.includes(qj) ? 0.92 : 0;
+  // a query that covers only part of a long name is still a good match, but slightly less than an exact one
+  return Math.round(Math.max(words * 0.97, whole, contained) * 1000) / 1000;
+}
+
+export const MATCH_MIN = 0.72;
+
+export function rank<T>(query: string, items: T[], names: (t: T) => unknown[], min = MATCH_MIN): (T & { score: number })[] {
+  return items
+    .map((it) => ({ ...it, score: Math.max(0, ...names(it).filter(Boolean).map((n) => fuzzyScore(query, n))) }))
+    .filter((x) => x.score >= min)
+    .sort((a, b) => b.score - a.score);
+}
+
+// ============================ staples ============================
+
+export interface Staple {
+  name: string;
+  aliases: string[];
+  brand: string | null;
+  basis: "per_100g" | "per_unit";
+  nutrients: Nutr | null;            // for `basis`; null = no figures yet
+  unit_label: string | null;         // e.g. "egg", "slice", "scoop"
+  unit_grams: number | null;         // grams in one unit
+  source: "label" | "usda" | "estimate";
+  verified: boolean;
+  suspect: string | null;            // why the figures are doubted
+  notes: string | null;
+  updated_at: number | null;
+}
+
+export function stapleFromRow(r: any): Staple {
+  return {
+    name: r.name, aliases: (safeParse(r.aliases ?? "[]") as any) || [], brand: r.brand ?? null,
+    basis: r.basis === "per_unit" ? "per_unit" : "per_100g",
+    nutrients: r.nutrients ? (safeParse(r.nutrients) as Nutr) : null,
+    unit_label: r.unit_label ?? null, unit_grams: r.unit_grams ?? null,
+    source: r.source, verified: !!r.verified, suspect: r.suspect ?? null, notes: r.notes ?? null, updated_at: r.updated_at ?? null,
+  };
+}
+
+export function cleanNutrients(n: Record<string, unknown> | undefined | null): Nutr {
+  const out: Nutr = {};
+  const allowed = new Set<string>(NUTRIENT_KEYS as unknown as string[]);
+  for (const [k, v] of Object.entries(n ?? {})) {
+    if (!allowed.has(k)) throw new Error(`unknown nutrient key "${k}"`);
+    if (typeof v === "number" && Number.isFinite(v) && v >= 0) out[k] = v;
+  }
+  return out;
+}
+
+const r2 = (x: number) => Math.round(x * 100) / 100;
+
+export type StapleUnit = "g" | "ml" | "unit";
+
+/** Map a free-form unit ("grams", "eggs", "slice", "units") onto g / ml / unit for this staple. */
+export function parseUnit(unit: string, s: Pick<Staple, "unit_label">): StapleUnit | null {
+  const u = singular(normalize(unit));
+  if (["g", "gram", "gm", "gr"].includes(u)) return "g";
+  if (["ml", "millilitre", "milliliter"].includes(u)) return "ml";
+  if (["unit", "each", "item", "piece", "serving", "portion", "x", ""].includes(u)) return "unit";
+  if (s.unit_label && (fuzzyScore(u, s.unit_label) >= 0.8)) return "unit";
+  return null;
+}
+
+/** TOTAL nutrients for `amount` of a staple. Throws a human-readable reason when it can't. */
+export function computeStaple(s: Staple, amount: number, unit: string) {
+  if (!(amount > 0)) throw new Error("amount must be greater than 0");
+  if (!s.nutrients || s.nutrients.energy == null) throw new Error(`"${s.name}" has no nutrition figures yet`);
+  const u = parseUnit(unit, s);
+  if (!u) throw new Error(`unknown unit "${unit}" — use g, ml or ${s.unit_label ? `"${s.unit_label}"/unit` : "unit"}`);
+  let factor: number;
+  let grams: number | null = null;
+  if (u === "g" || u === "ml") {
+    grams = amount;
+    if (s.basis === "per_100g") factor = amount / 100;
+    else if (s.unit_grams) factor = amount / s.unit_grams;
+    else throw new Error(`"${s.name}" is defined per ${s.unit_label ?? "unit"} with no gram weight — log it in ${s.unit_label ?? "units"}`);
+  } else {
+    if (s.basis === "per_unit") factor = amount;
+    else if (s.unit_grams) factor = (amount * s.unit_grams) / 100;
+    else throw new Error(`"${s.name}" is defined per 100 g with no unit weight — log it in grams`);
+    if (s.unit_grams) grams = amount * s.unit_grams;
+  }
+  const nutrients: Nutr = {};
+  for (const [k, v] of Object.entries(s.nutrients)) nutrients[k] = r2(v * factor);
+  const qty = `${r2(amount)}${u === "unit" ? ` ${s.unit_label ?? "unit"}${amount === 1 ? "" : "s"}` : u === "ml" ? " ml" : " g"}`;
+  const label = u === "unit" && grams != null ? `${qty}, ${Math.round(grams)} g` : qty;
+  return { nutrients, grams: grams != null ? r2(grams) : null, label, factor: r2(factor), unit: u };
+}
+
+export function staplePrompt(s: Staple): string | null {
+  if (s.verified && !s.suspect) return null;
+  const why = s.suspect ? `Its saved figures look wrong (${s.suspect}).` : `Its figures are ${s.source === "usda" ? "generic USDA values" : "an estimate"}, not from the label.`;
+  return (
+    `Ask Mark for the label figures for "${s.name}"${s.brand ? ` (${s.brand})` : ""}: energy (kcal or kJ), protein, carbs, ` +
+    `fat (and fibre/sugars/sodium if shown) per 100 g or per serving, plus the serving weight. ${why} ` +
+    `Then call upsert_staple with source:"label", verified:true.`
+  );
+}
+
+// ============================ missed-log alerts ============================
+
+export interface QueueRow { id: number; created: number; claimed_at: number | null; names: string[] }
+
+/** Items queued (or claimed by the phone) but not confirmed for at least `minAgeMs`. */
+export function selectMissed(rows: QueueRow[], now: number, minAgeMs = 30 * 60_000) {
+  return rows.filter((r) => now - (r.claimed_at ?? r.created) >= minAgeMs);
+}
+
+export function missedText(rows: QueueRow[]) {
+  const names = rows.flatMap((r) => r.names).filter(Boolean);
+  const shown = names.slice(0, 6).join(", ") + (names.length > 6 ? ` +${names.length - 6} more` : "");
+  return {
+    title: `MacroFactor: ${names.length} not logged yet`,
+    text: `Waiting to log: ${shown}. Tap to log them now.`,
+    count: names.length,
+    names,
+  };
+}
+
+/** Local HH:MM in the user's zone (for the DST-proof cron gate). */
+export function localHHMM(ms: number, tz = getUserTz()): string {
+  return new Intl.DateTimeFormat("en-GB", { timeZone: tz, hour: "2-digit", minute: "2-digit", hourCycle: "h23" }).format(new Date(ms));
+}
+
+/** Cron fires at both the NZDT and NZST UTC times; only the one that is really 20:30 / 23:40 local runs. */
+export function alertSlot(ms: number, tz = getUserTz()): "evening" | "pre_nightly" | null {
+  const [h, m] = localHHMM(ms, tz).split(":").map(Number);
+  const t = h * 60 + m;
+  if (Math.abs(t - (20 * 60 + 30)) <= 5) return "evening";
+  if (Math.abs(t - (23 * 60 + 40)) <= 5) return "pre_nightly";
+  return null;
+}
+
+// ============================ day feedback ============================
+
+const M4 = ["calories", "protein", "carbs", "fat"] as const;
+type M = Record<(typeof M4)[number], number>;
+export const toM = (n: Nutr | undefined | null): M => ({ calories: n?.energy ?? 0, protein: n?.protein ?? 0, carbs: n?.carbs ?? 0, fat: n?.fat ?? 0 });
+const addM = (a: M, b: M): M => ({ calories: a.calories + b.calories, protein: a.protein + b.protein, carbs: a.carbs + b.carbs, fat: a.fat + b.fat });
+const roundM = (a: M) => Object.fromEntries(M4.map((k) => [k, Math.round(a[k])])) as M;
+
+/**
+ * Where the day stands after a log. `base` = MacroFactor's own total at its last sync; `landedAfter`
+ * = foods confirmed since that sync; `queued` = still waiting for a tap. Pure, for testing.
+ */
+export function dayPosition(p: {
+  now: number; base: M | null; target: M | null; landedAfter: M[]; queued: M[]; firstFood: string | null; tz?: string;
+  zoe?: { zoe: unknown; received: number } | null;
+}) {
+  const tz = p.tz ?? getUserTz();
+  const eaten = [p.base ?? toM(null), ...p.landedAfter].reduce(addM);
+  const withQueued = p.queued.reduce(addM, eaten);
+  const nowHHMM = localHHMM(p.now, tz);
+  const [h, m] = nowHHMM.split(":").map(Number);
+  const out: Record<string, unknown> = {
+    as_of: nowHHMM,
+    eaten_including_this: roundM(withQueued),
+    still_waiting_for_tap: p.queued.length,
+  };
+  const notes: string[] = [];
+  if (p.target) {
+    const left = Object.fromEntries(M4.map((k) => [k, Math.round(p.target![k] - withQueued[k])])) as M;
+    out.target = roundM(p.target);
+    out.left = left;
+    // protein pace: a straight line from 07:00 to 20:00
+    const frac = Math.min(1, Math.max(0, (h * 60 + m - 7 * 60) / (13 * 60)));
+    const expected = p.target.protein * frac;
+    const gap = Math.round(withQueued.protein - expected);
+    out.protein_pace = { expected_by_now: Math.round(expected), gap };
+    if (gap <= -25) notes.push(`protein ${-gap} g behind pace for ${nowHHMM}`);
+    else if (gap >= 25) notes.push(`protein ${gap} g ahead of pace`);
+    if (left.calories < 0) notes.push(`${-left.calories} kcal over target`);
+    else if (left.calories < 300) notes.push(`only ${left.calories} kcal left`);
+    if (left.fat <= 10) notes.push(left.fat < 0 ? `fat ${-left.fat} g over` : `fat budget nearly used (${left.fat} g left)`);
+    if (left.carbs < 0) notes.push(`carbs ${-left.carbs} g over`);
+    if (left.protein > 0 && left.calories > 0) {
+      const ratio = left.protein / Math.max(left.calories, 1);
+      if (ratio > 0.12) notes.push(`remaining food needs to be very lean: ~${Math.round(left.protein)} g protein in ${left.calories} kcal`);
+    }
+  }
+  if (p.firstFood) {
+    const [fh, fm] = p.firstFood.split(":").map(Number);
+    const close = fh * 60 + fm + 12 * 60;
+    const closes = `${String(Math.floor(close / 60) % 24).padStart(2, "0")}:${String(close % 60).padStart(2, "0")}`;
+    out.eating_window = { first_food: p.firstFood, closes_at: closes };
+    const minsLeft = close - (h * 60 + m);
+    if (minsLeft < 0) notes.push(`past the 12-hour eating window (closed ${closes})`);
+    else if (minsLeft <= 90) notes.push(`eating window closes at ${closes}`);
+  }
+  out.notes = notes;
+  const z = p.zoe ? zoeFeedback(p.zoe.zoe, p.zoe.received, p.now, tz) : null;
+  if (z) out.zoe = z;
+  return out;
+}
+
+// ============================ ZOE rules (scored by Health Hub) ============================
+
+/** Health Hub's zoe_day() result → compact feedback + nudges for the time of day. Pure. */
+export function zoeFeedback(z: any, receivedMs: number, now: number, tz = getUserTz()) {
+  if (!z || typeof z !== "object") return null;
+  const [h, m] = localHHMM(now, tz).split(":").map(Number);
+  const mins = h * 60 + m;
+  const num = (v: unknown) => (typeof v === "number" && Number.isFinite(v) ? v : null);
+  const plants = num(z.plants_week), pace = num(z.plants_pace), target = num(z.plants_target) ?? 30;
+  const ferments = num(z.ferments), fibre = num(z.fibre);
+  const fermTarget = num(z.ferments_target) ?? 3, fibreTarget = num(z.fibre_target) ?? 30;
+  const notes: string[] = [];
+  if (plants != null && pace != null && plants < pace - 2) notes.push(`plants ${plants}/${target} this week, ${Math.round(pace - plants)} behind pace — add new ones`);
+  if (ferments != null) {
+    if (ferments < 1 && mins >= 12 * 60) notes.push("no fermented food yet today");
+    else if (ferments < fermTarget && mins >= 17 * 60) notes.push(`${ferments} of ${fermTarget} fermented portions`);
+  }
+  if (fibre != null) {
+    const expected = fibreTarget * Math.min(1, Math.max(0, (mins - 7 * 60) / (13 * 60)));
+    if (fibre < expected - 8) notes.push(`fibre ${fibre} g, behind pace for ${fibreTarget} g`);
+  }
+  const risky = Array.isArray(z.risky_items) ? z.risky_items.filter(Boolean) : [];
+  if (risky.length) notes.push(`processed: ${risky.slice(0, 2).join(", ")}`);
+  if (num(z.eating_window_h) != null && z.eating_window_h > (num(z.window_target) ?? 12)) notes.push(`eating window ${z.eating_window_h} h (ZOE: 12 h or less)`);
+  return {
+    as_of: localHHMM(receivedMs, tz),
+    score: num(z.score),
+    plants_week: plants, plants_target: target, plants_pace: pace, plants_today: Array.isArray(z.plants_today) ? z.plants_today : undefined,
+    ferments, ferments_target: fermTarget, fibre, fibre_target: fibreTarget,
+    processing_score: num(z.processing_score), risky_items: risky.length ? risky : undefined,
+    todo: Array.isArray(z.todo) ? z.todo : undefined,
+    notes,
+    coverage: "Scored by Health Hub from foods synced up to as_of; something logged since then isn't in these numbers yet.",
+  };
+}
+
+// ============================ D1 helpers ============================
+
+const nowMs = () => Date.now();
+
+export function localDate(ms: number, tz = getUserTz()): string {
+  return new Intl.DateTimeFormat("en-CA", { timeZone: tz, year: "numeric", month: "2-digit", day: "2-digit" }).format(new Date(ms));
+}
